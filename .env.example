# Copie este arquivo para ".env" (execução local) ou cadastre as variáveis
# em Settings > Environment Variables no painel da Vercel.

# Chave da API Groq (opcional) — usada para explicar votações em linguagem simples.
# Sem a chave, o sistema exibe um texto-base estruturado no lugar.
GROQ_API_KEY=""

# Chave da World News API (opcional) — amplia as fontes de notícias.
# Sem a chave, as demais fontes continuam funcionando.
WORLD_NEWS_API=""
