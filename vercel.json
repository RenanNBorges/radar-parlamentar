{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build --f",
  "outputDirectory": "dist",
  "functions": {
    "api/news.ts": { "maxDuration": 30 },
    "api/explain-vote.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
